#!/bin/bash
# このファイルをダブルクリックすると、ターミナルが自動で開いて「アップデート（旧版から設定を引き継いで更新）」が実行されます。
# 途中で「前のフォルダはどこ？」と聞かれたら、今まで使っていたフォルダをこのターミナル窓にドラッグ&ドロップしてください。
# （Mac用。Windowsの方は「アップデート.bat」をダブルクリックしてください）
cd "$(dirname "$0")" || { echo "フォルダの場所が分かりませんでした。"; read -r -n 1 -s; exit 1; }
bash update.sh
echo
echo "===================================================="
echo " 終わりました。このウィンドウは閉じて大丈夫です。"
echo " （何かキーを押すと閉じます）"
echo "===================================================="
read -r -n 1 -s
