#!/bin/bash
# このファイルをダブルクリックすると、ターミナルが自動で開いて「クラウドオフロード設定」が実行されます。
# （PCを閉じている間も予約投稿を動かせるようにする設定です）
# 途中で「Googleにログイン」する画面と、「URLをコピーして貼り付け」が1回ずつ出てきます。画面の案内に沿って進めてください。
# （Mac用。Windowsの方は「クラウドオフロード設定.bat」をダブルクリックしてください）
cd "$(dirname "$0")" || { echo "フォルダの場所が分かりませんでした。"; read -r -n 1 -s; exit 1; }
bash setup-cloud.sh
echo
echo "===================================================="
echo " 終わりました。このウィンドウは閉じて大丈夫です。"
echo " （何かキーを押すと閉じます）"
echo "===================================================="
read -r -n 1 -s
