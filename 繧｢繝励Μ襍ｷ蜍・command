#!/bin/bash
# このファイルをダブルクリックすると、ターミナルが自動で開いてアプリ（Webアプリ）が起動します。
# 起動すると、ブラウザで http://localhost:3000 の画面が開きます。
# 止めたい時は、このターミナル窓で「control」キーを押しながら「C」を押してください。
# （Mac用。Windowsの方は「アプリ起動.bat」をダブルクリックしてください）
cd "$(dirname "$0")" || { echo "フォルダの場所が分かりませんでした。"; read -r -n 1 -s; exit 1; }
bash start.sh
echo
echo "アプリを停止しました。もう一度起動したい時は、このファイルをまたダブルクリックしてください。"
echo "（何かキーを押すと閉じます）"
read -r -n 1 -s
